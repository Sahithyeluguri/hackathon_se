# Stretch: micro-segmentation on the DB host itself (defence in depth vs. same-subnet attackers)
table inet dbhost
delete table inet dbhost
table inet dbhost {
    chain input {
        type filter hook input priority filter; policy drop;
        iif lo accept
        ct state established,related accept
        ip saddr 10.20.30.30 tcp dport 5432 counter accept   # only the app server may query
        ip saddr 10.20.99.60 tcp dport 22   counter accept   # only admin may SSH
        counter log group 0 prefix "DB-DROP " drop
    }
}
